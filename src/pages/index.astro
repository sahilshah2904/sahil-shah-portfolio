---
import { ArrowUpRight, ArrowDown, Download, CodeXml, Plus, Pause, Play } from '@lucide/astro';
import Signal from '../components/Signal.astro';
import { profile, pipeline, projects, skills, experience, education } from '../data/resume';
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resume = `${base}/Sahil_Shah_Resume.pdf`;
const canonical = 'https://sahilshah2904.github.io/sahil-shah-portfolio/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101512" />
    <title>Sahil Shah — AI & Machine Learning Portfolio</title>
    <meta name="description" content="Sahil Shah: Curtin AI graduate and former Accenture SAP ABAP developer. Explore ECG deep learning, medical imaging projects, experience and resume." />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Sahil Shah — Turning signals into insight." />
    <meta property="og:description" content="Artificial intelligence. Applied thoughtfully. Explore my work in deep learning, medical imaging and enterprise software." />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${canonical}social-preview.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try { if (localStorage.getItem('portfolio-motion') === 'off') document.documentElement.dataset.motion = 'off'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="#home" aria-label="Sahil Shah home">sahil<span class="wordmark-dot">.</span><span class="wordmark-last">shah</span></a>
        <nav aria-label="Main navigation">
          <a href="#work">Work</a><a href="#expertise">Expertise</a><a href="#journey">Journey</a>
        </nav>
        <a class="header-contact" href="#contact">Let’s connect <ArrowUpRight size={16}/></a>
      </div>
      <div class="reading-progress" aria-hidden="true"></div>
    </header>

    <main id="main">
      <section id="home" class="hero section-shell" aria-labelledby="hero-title">
        <div class="hero-topline mono"><span><span class="status-dot"></span> AI & MACHINE LEARNING</span><span class="edition">PORTFOLIO / 2026</span></div>
        <div class="hero-composition">
          <div class="hero-copy">
            <p class="eyebrow">HELLO, I’M SAHIL SHAH</p>
            <h1 id="hero-title">Turning signals<br/>into <em>insight.</em></h1>
            <p class="hero-description">I explore how intelligent systems can make complex data meaningful. From ECG signals to enterprise software, I build with curiosity and evaluate with care.</p>
            <div class="hero-actions"><a class="button button-primary" href="#work">Explore my work <ArrowDown size={17}/></a><a class="text-link" href={resume} download>Download resume <Download size={16}/></a></div>
          </div>
          <div class="hero-visual">
            <span class="visual-caption mono">FIG. 01 — FINDING THE SIGNAL</span>
            <Signal />
            <div class="visual-foot mono"><span>RAW SIGNAL → MEANING</span><span class="visual-plus">+</span></div>
          </div>
        </div>
        <div class="hero-footer"><p>CURTIN UNIVERSITY <span>/</span> MASTER OF COMPUTING, AI</p><a href="#about" class="scroll-cue">A little context <ArrowDown size={15}/></a></div>
      </section>

      <section id="about" class="about section-shell" aria-labelledby="about-title">
        <div class="section-kicker"><span class="mono">01 / THE APPROACH</span><span class="section-line"></span></div>
        <div class="about-grid"><h2 id="about-title">Curiosity in the process.<br/><span class="muted-heading">Clarity in the outcome.</span></h2><div><p>{profile.summary}</p><p class="subtle">I enjoy the full journey: preparing data, exploring models, questioning the results, and making the work useful. Dependable in a team, adaptable when the problem changes.</p></div></div>
        <div class="credential-strip"><span>PYTHON & PYTORCH</span><span>DEEP LEARNING</span><span>SAP ABAP</span><span>APPLIED RESEARCH</span></div>
      </section>

      <div class="signal-bridge section-shell" aria-hidden="true"><svg viewBox="0 0 1200 90" preserveAspectRatio="none"><path class="bridge-path" d="M0 45H475l15-15 15 30 18-15h27l13-35 20 70 20-70 20 35h577"/></svg><span class="mono">FOLLOW THE SIGNAL</span></div>

      <section id="work" class="work section-shell" aria-labelledby="work-title">
        <div class="section-kicker"><span class="mono">02 / SELECTED WORK</span><span class="mono subtle">2022 — 2026</span></div>
        <div class="section-heading"><div><p class="eyebrow">FEATURED PROJECT · AUG 2025 — MAY 2026</p><h2 id="work-title">From a heartbeat<br/>to a <em>deeper understanding.</em></h2></div><span class="project-index" aria-hidden="true">01</span></div>
        <p class="work-intro">Explainable AI for Cardiovascular Disease. A closer look at the data, decisions and evaluation behind an ECG classification ensemble.</p>
        <div class="pipeline-layout">
          <div class="pipeline-stage">
            <div class="stage-top mono"><span class="stage-status"><span class="status-dot"></span><span id="stage-label">01 / DATA</span></span><span>ECG / AI</span></div>
            <Signal variant="pipeline" />
            <div class="stage-bottom"><span class="mono" id="stage-caption">63,851 RECORDS · THREE DATASETS</span><span class="mono subtle">ILLUSTRATIVE</span></div>
            <nav class="chapter-nav" aria-label="ECG project chapters">{pipeline.map(step => <a href={`#${step.id}`} data-step-link={step.number} aria-label={`${step.number}: ${step.label}`}>{step.number}<span>{step.label}</span></a>)}</nav>
          </div>
          <div class="pipeline-chapters">{pipeline.map((step, i) => <article class="pipeline-chapter" id={step.id} data-step={i} aria-labelledby={`${step.id}-title`}>
            <p class="eyebrow"><span>{step.number}</span> / {step.label}</p><h3 id={`${step.id}-title`}>{step.title}</h3><p>{step.description}</p><div class="chapter-metric"><strong>{step.metric}</strong><span>{step.unit}</span></div>
          </article>)}</div>
        </div>
        <div class="project-footnote"><span class="mono">THE TAKEAWAY</span><p>Reliable AI starts well before a model—and continues long after a score.</p><a class="text-link" href={resume}>Read the resume <ArrowUpRight size={17}/></a></div>
      </section>

      <section id="projects" class="project-explorer light-section" aria-labelledby="projects-title">
        <div class="section-shell">
          <div class="section-kicker"><span class="mono">MORE EXPLORATIONS</span><span class="mono">SAME CURIOSITY. DIFFERENT LENSES.</span></div>
          <div class="explorer-layout">
            <div class="explorer-art" aria-hidden="true" data-project="xray">
              <div class="art-label mono">RESEARCH NOTE / <span id="explorer-number">02</span></div>
              <svg class="project-art" viewBox="0 0 480 440" fill="none">
                <defs><pattern id="project-grid" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".8" fill="#305940" opacity=".22"/></pattern></defs>
                <rect width="480" height="440" fill="url(#project-grid)"/>
                <g class="xray-art" stroke="#326145" stroke-width="1.4">
                  <path d="M236 83v250M245 83v250" opacity=".45"/>
                  <path d="M207 105c-34 2-73 63-83 128-9 58 7 104 48 100 39-4 52-51 49-95l-2-108c0-18-4-27-12-25Z"/>
                  <path d="M273 105c34 2 73 63 83 128 9 58-7 104-48 100-39-4-52-51-49-95l2-108c0-18 4-27 12-25Z"/>
                  {[0,1,2,3,4,5].map(i => <><path d={`M${207-i*3} ${140+i*26} Q ${137-i} ${158+i*26} ${136+i*2} ${170+i*26}`} opacity=".45"/><path d={`M${273+i*3} ${140+i*26} Q ${343+i} ${158+i*26} ${344-i*2} ${170+i*26}`} opacity=".45"/></>)}
                  <rect class="scan-box" x="275" y="188" width="64" height="65" rx="3" stroke-dasharray="4 4"/><circle cx="307" cy="220" r="13" fill="#a7cbb0" fill-opacity=".5"/>
                  <path d="M339 220h47v-56h30" stroke-dasharray="3 4"/><circle cx="416" cy="164" r="4" fill="#326145"/>
                </g>
                <g class="tb-art" stroke="#326145" stroke-width="1.5">
                  <path d="M75 220h45l80-115h95l70 115h45M120 220h245M120 220l80 115h95l70-115"/>
                  {[105,220,335].map((y, i) => <g><circle cx="245" cy={y} r="42" fill="#e8eadf"/><text x="245" y={y+5} text-anchor="middle" fill="#326145" stroke="none" font-size="12" font-family="monospace">{['RF','SVM','LR'][i]}</text></g>)}
                  <circle cx="75" cy="220" r="7" fill="#326145"/><circle cx="410" cy="220" r="9" fill="#326145"/>
                </g>
              </svg>
              <div class="art-footer mono"><span id="explorer-caption">CLASSIFY / LOCALISE / EXPLAIN</span><span>CONCEPT STUDY</span></div>
            </div>
            <div class="explorer-copy"><h2 id="projects-title">A different<br/><em>way of seeing.</em></h2><p class="explorer-lead">Exploring medical images through machine learning—and making the results easier to interpret.</p>
              <div class="project-disclosures">{projects.map((project, i) => <details class="project-detail" open={i === 0} data-project-id={project.id}>
                <summary><span class="mono">{project.index}</span><span>{project.title}</span><Plus size={20}/></summary><div class="project-detail-body"><p class="mono date-label">{project.date}</p><h3>{project.name}</h3><p>{project.description}</p><ul class="tag-list" aria-label="Technologies">{project.tools.map(tool => <li>{tool}</li>)}</ul></div>
              </details>)}</div>
            </div>
          </div>
        </div>
      </section>

      <section id="expertise" class="expertise section-shell" aria-labelledby="expertise-title">
        <div class="section-kicker"><span class="mono">03 / THE TOOLKIT</span><span class="section-line"></span></div>
        <div class="section-heading"><h2 id="expertise-title">Ideas need<br/><em>good foundations.</em></h2><p>A connected set of skills.<br/>Built through practice.</p></div>
        <div class="skills-flow">{skills.map((skill, i) => <article class="skill-group"><span class="skill-node" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><h3>{skill.title}<ArrowUpRight size={20}/></h3><ul>{skill.items.map(item => <li>{item}</li>)}</ul><p>{skill.note}</p></article>)}</div>
      </section>

      <section id="journey" class="journey section-shell" aria-labelledby="journey-title">
        <div class="section-kicker"><span class="mono">04 / THE JOURNEY</span><span class="section-line"></span></div>
        <div class="section-heading"><h2 id="journey-title">Different experiences.<br/><em>A shared perspective.</em></h2></div>
        <div class="journey-layout"><div class="journey-intro"><p>Enterprise development taught me to build for real requirements. Research taught me to ask better questions.</p><p class="subtle">Along the way, customer-facing roles have strengthened how I collaborate, solve problems and deliver under pressure.</p><span class="journey-mark" aria-hidden="true">↘</span></div>
          <div class="career-list"><p class="eyebrow">PROFESSIONAL & ADDITIONAL EXPERIENCE</p>{experience.map((job, i) => <article class:list={['career-item', { featured: i === 0 }]}><div class="career-dot" aria-hidden="true"></div><p class="mono date-label">{job.date}</p><h3>{job.company}<span>{job.role}</span></h3><p class="job-detail">{job.detail}</p><p>{job.description}</p><ul class="tag-list" aria-label="Experience focus">{job.tags.map(tag => <li>{tag}</li>)}</ul></article>)}</div>
        </div>
        <div class="education-layout"><div><p class="eyebrow">EDUCATION</p><h3>Learning, with intent.</h3></div><div class="education-list">{education.map(item => <article><span class="mono date-label">{item.date}</span><h4>{item.degree}</h4><p>{item.major}</p><p class="subtle">{item.school}</p><span class="education-result">{item.result}</span></article>)}</div></div>
        <div class="awards"><div class="award"><span class="award-symbol" aria-hidden="true">✳</span><div><h3>Two Dean’s Letters of Commendation</h3><p>Curtin University · Semester 2, 2024 & Semester 1, 2025</p></div></div><div class="award"><span class="award-symbol" aria-hidden="true">↗</span><div><h3>First place · Kaizen 2022</h3><p>Final-year project · Award presented by Jitu Vaghani, then Education Minister of Gujarat</p></div></div></div>
      </section>

      <section id="contact" class="contact section-shell" aria-labelledby="contact-title">
        <div class="section-kicker"><span class="mono">05 / WHAT’S NEXT?</span><span class="mono">LET’S FIND OUT.</span></div>
        <h2 id="contact-title">Good things start<br/>with a <em>conversation.</em></h2>
        <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}<ArrowUpRight size={32}/></a>
        <div class="contact-bottom"><p>Have an interesting problem or an opportunity to share?<br/>I’d love to hear about it.</p><div class="contact-links"><a href={profile.github} target="_blank" rel="noopener noreferrer"><CodeXml size={17}/> GitHub <ArrowUpRight size={15}/></a><a href={resume} download><Download size={17}/> Resume</a></div></div>
      </section>
    </main>

    <footer class="site-footer section-shell"><a class="wordmark" href="#home">sahil<span class="wordmark-dot">.</span><span class="wordmark-last">shah</span></a><span class="mono">BUILT WITH CURIOSITY. © {new Date().getFullYear()} SAHIL SHAH.</span><button class="motion-toggle" id="motion-toggle" type="button" aria-pressed="false" hidden><span class="pause-icon"><Pause size={14}/></span><span class="play-icon"><Play size={14}/></span><span id="motion-label">Animations on</span></button></footer>
    <script>
      import { initPortfolio } from '../scripts/portfolio';
      initPortfolio();
    </script>
  </body>
</html>
